# Port is provided by Railway automatically; only set it for local runs.
PORT=3000

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4200,https://redtekk.com,https://www.redtekk.com

# Where contact form submissions are delivered.
CONTACT_TO=hello@redtekk.com
CONTACT_FROM=Redtekk Website <no-reply@redtekk.com>

# SMTP credentials (e.g. Brevo). If SMTP_HOST is empty, submissions are
# logged to the console instead of emailed - useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
